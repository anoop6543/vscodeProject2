import random
from enum import Enum
from typing import List, Tuple
import math

# Enums for Gripper Types and Object Types
class GripperType(Enum):
    SUCTION = "Suction"
    PARALLEL = "Parallel"
    MAGNETIC = "Magnetic"
    SOFT = "Soft"

class ObjectType(Enum):
    BOX = "Box"
    CYLINDER = "Cylinder"
    SHEET = "Sheet"
    METAL_PART = "MetalPart"
    FRAGILE = "Fragile"

# Motor and Drive classes
class Motor:
    def __init__(self, axis: str, max_speed: float, max_torque: float):
        self.axis = axis
        self.max_speed = max_speed
        self.max_torque = max_torque
        self.position = 0.0

    def move_to(self, position: float, speed: float):
        if speed > self.max_speed:
            speed = self.max_speed
        print(f"[Motor-{self.axis}] Moving to {position} at {speed} mm/s")
        self.position = position

class Drive:
    def __init__(self, motor: Motor):
        self.motor = motor

    def command_move(self, position: float, speed: float):
        self.motor.move_to(position, speed)

# Sensors
class Sensor:
    def __init__(self, name: str):
        self.name = name

    def read(self):
        return random.choice([True, False])

class PositionSensor(Sensor):
    def __init__(self, axis: str):
        super().__init__(f"PositionSensor-{axis}")

    def get_position(self, motor: Motor):
        return motor.position

class ForceSensor(Sensor):
    def __init__(self):
        super().__init__("ForceSensor")

    def get_force(self):
        return random.uniform(0, 100)  # Newtons

# Gripper classes
class Gripper:
    def __init__(self, gripper_type: GripperType):
        self.gripper_type = gripper_type

    def pick(self, obj_type: ObjectType):
        print(f"[Gripper-{self.gripper_type.value}] Picking {obj_type.value}")

    def place(self, location: Tuple[float, float, float]):
        print(f"[Gripper-{self.gripper_type.value}] Placing at {location}")

# Gantry Robot System
class GantryRobot:
    def __init__(self):
        # 8 DOF: X, Y, Z, Extend, Retract, Rotate, Tilt, Gripper Open/Close
        self.motors = [
            Motor("X", 2000, 10),
            Motor("Y", 2000, 10),
            Motor("Z", 1500, 8),
            Motor("Extend", 2500, 5),
            Motor("Retract", 2500, 5),
            Motor("Rotate", 360, 2),
            Motor("Tilt", 180, 2),
            Motor("Gripper", 100, 1)
        ]
        self.drives = [Drive(motor) for motor in self.motors]
        self.position_sensors = [PositionSensor(motor.axis) for motor in self.motors]
        self.force_sensor = ForceSensor()
        self.grippers = [
            Gripper(GripperType.SUCTION),
            Gripper(GripperType.PARALLEL),
            Gripper(GripperType.MAGNETIC),
            Gripper(GripperType.SOFT)
        ]
        self.current_gripper = self.grippers[0]
        self.laser_status = "OFF" # Added for laser_weld

    def arc_move(self, start_point: Tuple[float, float, float], 
                 end_point: Tuple[float, float, float], 
                 center_point: Tuple[float, float], 
                 speed: float):
        """
        Move in an arc from start_point to end_point around center_point in the XY plane.
        Z coordinate is kept constant from start_point.
        Orientation (rotate, tilt) is kept constant at current motor positions.
        """
        print("\nStarting arc movement...")
        
        x1, y1, z1 = start_point
        x2, y2, _ = end_point  # z2 from end_point is not used for path, Z is constant from z1
        xc, yc = center_point

        # Calculate radii from center to start and end points
        r1 = math.sqrt((x1 - xc)**2 + (y1 - yc)**2)
        r2 = math.sqrt((x2 - xc)**2 + (y2 - yc)**2)

        if not math.isclose(r1, r2, rel_tol=1e-5):
            print(f"Warning: Start and end points are not equidistant from the center. r1={r1:.2f}, r2={r2:.2f}")
            # Using start_point's radius for the arc
        
        radius = r1

        if radius == 0:
            print("Error: Radius is zero. Cannot form an arc. Moving directly to end_point.")
            # Fallback: move directly to the end_point's X, Y, maintaining start_point's Z
            current_orientation = (self.motors[5].position, self.motors[6].position)
            self.move_to((x2, y2, z1), current_orientation)
            print("Arc movement finished (direct move due to zero radius).")
            return

        # Calculate start and end angles
        start_angle = math.atan2(y1 - yc, x1 - xc)
        end_angle = math.atan2(y2 - yc, x2 - xc)

        # Determine the direction of the arc (shortest path)
        angle_diff = end_angle - start_angle
        # Normalize angle_diff to be between -pi and pi for shortest path
        if angle_diff > math.pi:
            angle_diff -= 2 * math.pi
        elif angle_diff < -math.pi:
            angle_diff += 2 * math.pi
        
        # Number of steps
        # Based on fixed angular increment for simplicity, similar to compound_movements.py
        if math.isclose(angle_diff, 0, abs_tol=1e-6) : # Start and end angles are effectively the same
            if math.isclose(x1,x2) and math.isclose(y1,y2): # if points are also same
                num_steps = 0 # No movement needed if start and end are the same point
                print("Start and end points for arc are effectively the same. No arc movement executed.")
            else: # if angles are same but points are different (e.g. center is on the line connecting them)
                  # This case should ideally be handled by radius check or better geometry logic
                  # For now, treat as a straight line if angles are same but points differ.
                print("Warning: Arc start and end angles are the same but points differ. Moving in straight line to target XY.")
                num_steps = 1 # Move directly to end point's XY
        else:
            angle_increment_fixed = 0.05 # radians, about 3 degrees
            num_steps = max(2, int(abs(angle_diff) / angle_increment_fixed))

        print(f"Arc Details: Radius: {radius:.2f}, Start Angle: {math.degrees(start_angle):.2f} deg, End Angle: {math.degrees(end_angle):.2f} deg")
        print(f"Angle Difference: {math.degrees(angle_diff):.2f} deg, Number of Steps: {num_steps}")

        if num_steps == 0: # Handles the case where start and end points are identical
             # Current orientation
            current_orientation = (self.motors[5].position, self.motors[6].position)
            # Ensure robot is at start_point (or end_point, since they are same)
            self.move_to((x1,y1,z1), current_orientation)
            print("Arc movement finished (start and end are the same).")
            return
        
        # Get current orientation (Rotate, Tilt) - assuming motors 5 and 6
        # These will be kept constant throughout the arc move.
        current_rotate_pos = self.motors[5].position
        current_tilt_pos = self.motors[6].position
        current_orientation = (current_rotate_pos, current_tilt_pos)

        # Initial move to the start_point of the arc to ensure correct Z and orientation
        # print(f"Moving to arc start point: ({x1:.2f}, {y1:.2f}, {z1:.2f}) with orientation {current_orientation}")
        # self.move_to((x1, y1, z1), current_orientation)

        for i in range(num_steps + 1):
            # Interpolate angle
            current_angle = start_angle + (angle_diff / num_steps) * i
            
            # Calculate intermediate point coordinates
            x = xc + radius * math.cos(current_angle)
            y = yc + radius * math.sin(current_angle)
            # Z is kept constant from start_point.z1
            
            # print(f"Arc Step {i}: Target ({x:.2f}, {y:.2f}, {z1:.2f}), Angle: {math.degrees(current_angle):.2f} deg")
            self.move_to((x, y, z1), current_orientation) # speed is handled by move_to's default or could be passed

        # Ensure the robot is precisely at the intended end_point (x2,y2,z1)
        # This corrects any potential floating point errors from interpolation.
        print(f"Ensuring robot reaches final arc point: ({x2:.2f}, {y2:.2f}, {z1:.2f})")
        self.move_to((x2, y2, z1), current_orientation)
        
        print("Arc movement finished.")

    def select_gripper(self, obj_type: ObjectType):
        if obj_type == ObjectType.BOX or obj_type == ObjectType.SHEET:
            self.current_gripper = self.grippers[0]  # Suction
        elif obj_type == ObjectType.CYLINDER:
            self.current_gripper = self.grippers[1]  # Parallel
        elif obj_type == ObjectType.METAL_PART:
            self.current_gripper = self.grippers[2]  # Magnetic
        elif obj_type == ObjectType.FRAGILE:
            self.current_gripper = self.grippers[3]  # Soft
        print(f"Selected gripper: {self.current_gripper.gripper_type.value}")

    def move_to(self, position: Tuple[float, float, float], orientation: Tuple[float, float]):
        # position: (x, y, z), orientation: (rotate, tilt)
        axes = ["X", "Y", "Z", "Rotate", "Tilt"]
        values = list(position) + list(orientation)
        for i, axis in enumerate(axes):
            self.drives[i].command_move(values[i], speed=1000)
            print(f"Sensor-{axis}: {self.position_sensors[i].get_position(self.motors[i])}")

    def extend_retract(self, extend: bool):
        idx = 3 if extend else 4
        action = "Extending" if extend else "Retracting"
        self.drives[idx].command_move(100 if extend else 0, speed=2000)
        print(f"{action} axis to position {self.motors[idx].position}")

    def operate_gripper(self, open: bool):
        idx = 7
        action = "Opening" if open else "Closing"
        self.drives[idx].command_move(1 if open else 0, speed=100)
        print(f"{action} gripper")

    def pick_and_place(self, obj_type: ObjectType, pick_pos: Tuple[float, float, float], place_pos: Tuple[float, float, float]):
        self.select_gripper(obj_type)
        self.move_to(pick_pos, (0, 0))
        self.extend_retract(True)
        self.operate_gripper(False)
        self.current_gripper.pick(obj_type)
        print(f"Force detected: {self.force_sensor.get_force():.2f}N")
        self.extend_retract(False)
        self.move_to(place_pos, (0, 0))
        self.extend_retract(True)
        self.operate_gripper(True)
        self.current_gripper.place(place_pos)
        self.extend_retract(False)

